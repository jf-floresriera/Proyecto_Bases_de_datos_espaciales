# Copiar a .env y ajustar. .env no se versiona.
PGUSER=bde
PGPASSWORD=cambiar_esta_clave
PGDATABASE=bde_t01
PGPORT_HOST=5433

# Presupuesto de recursos idéntico para PostGIS y para el laboratorio
LAB_CPUS=4
LAB_MEM=6g

# PostgreSQL
PG_SHARED_BUFFERS=1GB
PG_WORK_MEM=64MB
PG_PARALLEL_WORKERS=4

# DuckDB (el experimento E3 varía este valor)
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# Datos: versión de Overture Maps (vacío = la más reciente según el catálogo STAC)
OVERTURE_RELEASE=

# Plataforma de la imagen de PostGIS (solo se publica para amd64).
# En macOS con Apple Silicon se ejecuta emulada; no cambiar salvo que se use
# una imagen arm64 propia.
PG_PLATFORM=linux/amd64
