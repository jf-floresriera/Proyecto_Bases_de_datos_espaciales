# Finales de línea estables en Linux, macOS y Windows.
# Los scripts que se ejecutan dentro de los contenedores Linux deben llevar LF:
# un script con CRLF falla con "bad interpreter" o "\r: command not found".
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.qmd  text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf
*.parquet binary
*.png  binary
